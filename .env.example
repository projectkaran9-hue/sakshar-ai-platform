# ── Supabase ───────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Gemini AI ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
VITE_GEMINI_API_KEY=your-gemini-api-key

# ── AWS Bedrock (optional — for Claude / LLaMA fallback tutor) ─────────────
AWS_BEARER_TOKEN_BEDROCK=your-aws-bearer-token
AWS_REGION_BEDROCK=us-east-1
AWS_MODEL_ID_BEDROCK=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# ── Web Push Notifications (VAPID) ────────────────────────────────────────
# Generate your own keys once by running:  python backend/generate_vapid_keys.py
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----
VAPID_CLAIMS_EMAIL=mailto:admin@yourdomain.com
